{
	"name": "directus-extension-email-send",
	"description": "A thin courier endpoint that dispatches fully-specified email requests to the internal Directus MailService.",
	"icon": "extension",
	"version": "2.0.0",
	"license": "GPL-3.0-only",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-endpoint"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "endpoint",
		"path": "dist/index.js",
		"source": "src/index.ts",
		"host": "^12.0.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "18.0.5",
		"@types/node": "^26.6.3",
		"typescript": "^7.0.2",
		"valibot": "^1.5.0",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"@directus/errors": "^2.5.2"
	}
}
